# Optional Docker image and host ownership
GITLAB_MIGRATOR_IMAGE=ghcr.io/andjoy404/gitlab-migrator:latest
USER_ID=1000
GROUP_ID=1000

# Required GitLab connection settings
#
# SOURCE_TOKEN needs API access to read the source group and projects.
# DEST_TOKEN needs API access to create and update destination resources.
SOURCE_URL=https://gitlab.com
SOURCE_TOKEN=replace-with-source-api-token
SOURCE_GROUP=source-group

DEST_URL=https://gitlab.example.com
DEST_TOKEN=replace-with-destination-api-token
DEST_ROOT_GROUP=destination-group

# Required only for container-registry migration
SOURCE_REGISTRY=registry.gitlab.com
SOURCE_REGISTRY_USER=source-registry-username
SOURCE_REGISTRY_TOKEN=replace-with-source-read-registry-token

DEST_REGISTRY=registry.gitlab.example.com
DEST_REGISTRY_USER=destination-registry-username
DEST_REGISTRY_TOKEN=replace-with-destination-write-registry-token

# Optional migration filters. Set only one of these three values.
MIGRATE_PROJECT=
MIGRATE_GROUP=
MIGRATE_GROUPS=

# Optional comma-separated exclusions. Group exclusions include all descendants.
EXCLUDE_PROJECTS=
EXCLUDE_GROUPS=

# Optional concurrency
MIGRATE_WORKERS=1

# Optional runner settings
RUNNER_GROUP=
RUNNER_SSH_CONNECT_TIMEOUT=5

# Optional runtime locations, resolved from the current directory
GITLAB_MIGRATOR_OUTPUT_DIR=data/reports
GITLAB_MIGRATOR_WORKSPACE_DIR=data/repositories
