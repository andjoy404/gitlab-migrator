# Image and host ownership
GITLAB_MIGRATOR_IMAGE=ghcr.io/andjoy404/gitlab-migrator:latest
USER_ID=1000
GROUP_ID=1000

# Required GitLab connection settings
SOURCE_URL=https://gitlab.example.com
SOURCE_TOKEN=replace-with-source-token
SOURCE_GROUP=source-group
DEST_URL=https://gitlab.destination.example.com
DEST_TOKEN=replace-with-destination-token
DEST_ROOT_GROUP=destination-group

# Required only for container-registry migration
SOURCE_REGISTRY=registry.gitlab.example.com
SOURCE_REGISTRY_USER=source-user
SOURCE_REGISTRY_TOKEN=replace-with-source-registry-token
DEST_REGISTRY=registry.destination.example.com
DEST_REGISTRY_USER=destination-user
DEST_REGISTRY_TOKEN=replace-with-destination-registry-token

# Optional migration filters; set only one
MIGRATE_PROJECT=
MIGRATE_GROUP=

# Optional concurrency and runner settings
MIGRATE_WORKERS=1
RUNNER_GROUP=
RUNNER_SSH_CONNECT_TIMEOUT=5
